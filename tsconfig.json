{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@drizzle-sentinel/rules-engine": ["packages/rules-engine/src/index.ts"],
      "@drizzle-sentinel/mcp-server": ["packages/mcp-server/src/index.ts"]
    }
  }
}
